[resource]
script = ExtResource("1_l3b6a")
id = 35
sequence_id = "33"
display_name = "积之栗栗"
time_consume = 2
context = "割的声音密密响，堆起来像墙、像梳齿那么齐，一排仓门挨着打开往里装。
麦子割下来了，堆在场里，还没来得及脱粒。
天上却起了云，连着三天没开。
小满这个名字一直有两种说法：一说是麦粒渐满，一说是雨水渐盈。
新割的麦子，命运未卜。"
event_level = 1
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([7])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
