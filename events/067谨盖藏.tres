[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "分三路点数造册——仓里的盖草、窖里的封泥、场上盖席；
最远那几块田留着不收，让孤儿寡妇去拾。
收进来的没烂，没进仓的也没糟蹋。"
