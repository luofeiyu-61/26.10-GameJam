[resource]
script = ExtResource("1_l3b6a")
id = 70
sequence_id = "67"
display_name = "谨盖藏"
time_consume = 2
context = "这个月的令有一句：该收的都要收进去，该盖的都要盖起来，司徒要下去巡一遍，看有没有没收净、没敛齐的。
秋收的粮、场上的草、地里的柴、窖里的菜，今年冬天撑不撑得过去，就看这一遍巡得细不细。
最远的几块田上还摊着没收的。"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([18])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
