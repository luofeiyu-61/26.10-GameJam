[resource]
script = ExtResource("1_l3b6a")
id = 47
sequence_id = "45"
display_name = "溽暑"
time_consume = 1
context = "大暑的第二个候叫土润溽暑——土是湿的，气是闷的。
这一个字说的不是热，是湿：汗出在身上蒸不掉，全闷在里头，人最容易在这几天倒下。
地里的活正赶：秋禾在拔节，草也长得最快，锄一遍顶平时两遍。
水要挑到地头，日头最毒的那几个时辰歇不歇，得有人拿主意。"
event_level = 0
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([11])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
