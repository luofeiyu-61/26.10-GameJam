[resource]
script = ExtResource("1_l3b6a")
id = 9
sequence_id = "8"
display_name = "兹雨"
time_consume = 2
context = "这个节气叫\"雨水\"，可这地方这时候十年有七年不下透雨。
地表看着湿，麦苗返青要的那口水却不够。
天子问卜，只问两个字——\"兹雨？\""
