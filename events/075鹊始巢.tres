grain_feedback = 4
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "只留下村口那棵最高的，其余的窝都拆了当柴。
柴有了，风信也还剩一半——可只有一棵树作数，明年那几块地还是赌。"
meet_gua = Array[int]([6, 4])
belief_feedback = -4
air_feedback = -2
earth_feedback = -1
