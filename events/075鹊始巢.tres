[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "嫌柴不够烧，把垒了一半的窝连枝折下来扔进灶膛，惊得整群鹊挪去了别处。
火是旺了一夜；来年风从哪来没人知道，风口那几块谷子倒了一大片。"
belief_feedback = -3
air_feedback = -2
earth_feedback = 2
people_feedback = 1
