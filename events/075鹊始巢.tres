[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "一窝也不拆，还把垒得最高那窝记下来，看它开口朝哪边。
照着它分地：风口那几块改种矮的、耐倒的，背风那几块照旧。
这一年风没折什么，谷穗也沉。"
meet_gua = Array[int]([3, 5])
