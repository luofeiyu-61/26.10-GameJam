[resource]
script = ExtResource("1_l3b6a")
id = 78
sequence_id = "75"
display_name = "鹊始巢"
time_consume = 1
context = "喜鹊开始衔枝垒窝，一天一点，要垒大半月。                                                      老辈讲鹊能知风：窝垒得高，来年风大；垒得低，风小。                                      这话有一半是真的——鹊挑背风枝杈，风大的年份就得往上躲。                          今年村口那几棵树都动了工，靠东头那一窝垒得特别高。                                       拆、留，还是照着它定来年种什么，得定。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([22])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
