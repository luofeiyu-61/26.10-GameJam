[resource]
script = ExtResource("1_l3b6a")
id = 53
sequence_id = "51"
display_name = "登尝"
time_consume = 1
context = "谷上了场，第一口新谷不能先给人吃。老规矩是先荐寝庙——今年的新谷蒸好盛上，供进祖庙，回来才敢动筷子，这一年的礼叫尝。
荐剩下的那一份怎么处置，年年都要争一回：是分下去让国人都尝一口，还是照旧封进仓里等着。"
event_level = 0
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([13])
