[resource]
script = ExtResource("1_l3b6a")
id = 50
sequence_id = "48"
display_name = "缮囹圄"
time_consume = 1
context = "秋天一到，万物开始收敛，这个月的令也跟着收紧：修明法禁，把牢狱修葺一遍，把桎梏刑具备齐，务求把为非作歹的人抓到。
这一手上头还记着账——春天放出去一批轻犯，夏天给牢里的重囚添过粮，夏至那天连刑都停了。
现在要收了：牢里空着的囚室重新启用到什么程度，逃在外头的人追不追，这几天就得定。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([12])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
