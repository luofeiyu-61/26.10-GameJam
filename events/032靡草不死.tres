[resource]
script = ExtResource("1_l3b6a")
id = 34
sequence_id = "32"
display_name = "靡草不死"
time_consume = 1
context = "靡草是那些枝叶细软的草——荠菜、葶苈一类，一到这个节气就该枯。
今年到了日子，田埂上的靡草还绿着。
贞人翻开旧册子，念了一句：\"靡草不死，国纵盗贼。\""
event_level = 0
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([7])
