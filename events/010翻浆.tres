[resource]
script = ExtResource("1_l3b6a")
id = 11
sequence_id = "10"
display_name = "翻浆"
time_consume = 3
context = "太阳一天比一天毒，地表化了一层，底下还冻着。化开的水渗不下去
全泡在上头——
地里、路上全是烂泥，一脚下去拔不出鞋。
牛车陷在半道，粪肥运不到田里。立春要是淹过一场，这时候更糟。"
