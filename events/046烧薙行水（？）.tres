[resource]
script = ExtResource("1_l3b6a")
id = 47
sequence_id = "46"
display_name = "烧薙行水（？）"
time_consume = 2
context = "一年最热、雨也最勤的这半个月，地里的草长得比禾还快。
这时候有一种老法子：贴着地皮把草割倒，趁湿点火烧掉，再开水引着走一遍。
火烧在湿草上是闷的，走不快；水一过，热灰就随水渗进土里——草绝了根，地也肥上一年。
可这件事挑天：要烧在雨前，不能烧在风里。风向一变，火就由不得人了。"
event_level = 1
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([11])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
