[resource]
script = ExtResource("1_l3b6a")
id = 54
sequence_id = "52"
display_name = "穰秆不实"
context = "今年的谷子长得比往年高——秆子是壮的，穗也不小。可打下来过一遍风，空的比实的多：穰是穰，秆是秆，里头没米。
这是芒种那几天落下的账。那时候麦还在场上，夏播就要下地，有几块田是赶工赶出来的，种得晚了。
晚种的谷秆照样窜得高，抽穗也不晚多少；可灌浆要的是开花之后那一段积温，天一凉就停了。
现在就割，回来的粮少；再等几日赌一把尾温，又怕一场早霜全打在地里。"
event_level = 1
event_type = 2
trigger_terms = Array[int]([13])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
