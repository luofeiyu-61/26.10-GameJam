[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "敲锣打鼓地赶了一通。鹰是飞走了，鸡群也惊得半个月不下蛋；
等鹰再回来的时候，落单的两只羊羔已经没了。"
