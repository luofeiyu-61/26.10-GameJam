[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "不去惊它。场上摊的谷收进囤，鼠洞留着不堵，让它在场上自己捕；鸡雏关进笼，羊羔随母不出圈。
一冬下来鼠少了，人也没费一个工。"
