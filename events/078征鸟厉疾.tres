[resource]
script = ExtResource("1_l3b6a")
id = 81
sequence_id = "78"
display_name = "征鸟厉疾"
time_consume = 1
context = "征鸟是鹰隼一类，捕食又猛又快。
天冷，田里的鼠、野兔都往场上和仓边凑，鹰就跟着来了。
它替人捕鼠是好事，可它不挑：场上摊着没打净的谷，仓边有鼠洞，鸡雏、落单的羊羔也一样叼。
是赶，还是留着它替人捕鼠。"
event_level = 0
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([23])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
