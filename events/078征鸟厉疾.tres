[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "只在白日鸡放风那阵派人看着，天一黑收了鸡就不再问。
羊羔没丢，鸡也没惊着；可场边那几个鼠洞照旧，一冬下来粮还是要被啃去一些。"
