[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "没人听老农的“无稽之「变」”。
全族一哄而下，连没长成的小蛤也捞了，滩泥踩成一片稀浆。
捞回来的堆在场上，天还暖，没几天就臭了，只能连筐扔掉。"
meet_gua = Array[int]([0, 3])
belief_feedback = -6
air_feedback = -3
earth_feedback = -2
people_feedback = 0
animal_feedback = 0
grain_feedback = 0
