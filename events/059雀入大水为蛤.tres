[resource]
script = ExtResource("1_l3b6a")
id = 62
sequence_id = "59"
display_name = "雀入大水为蛤"
time_consume = 1
context = "入秋以后，地里、场边的雀一天比一天少见；
偏偏这时候，河滩和海口浅水里的蛤一个个肥得鼓起来，
退潮就露在外面，弯腰一捡就是一篓。
管事的老人说，雀是钻进水里变的，天在改物，动不得。
可滩就在那儿，蛤就在那儿——捡回来晒干，能顶一冬的菜和半春的粮。"
event_level = 0
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([16])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
