[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "没信「变」的说法。趁退潮派人下滩，采一批晒干入仓当冬春的口粮；
滩也划开了，采一片留一片，明年还有。"
