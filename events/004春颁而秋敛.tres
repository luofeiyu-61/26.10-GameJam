[resource]
script = ExtResource("1_l3b6a")
id = 4
sequence_id = "4"
display_name = "春颁而秋敛"
time_consume = 1
context = "立春前后，仓里陈粮见底、新粮还早，春耕却要起了。掌野粟的官摊开册子——能动的粟就这么多，发下去是口粮，留着是种子，这两样不能混：吃掉了就没种，种下去就挨饿。
开不开仓、按人头还是按亩、立不立券书、秋后收不收，都在这几天定。"
event_level = 1
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([3])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
