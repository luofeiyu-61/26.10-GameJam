[resource]
script = ExtResource("1_l3b6a")
id = 4
sequence_id = "4"
display_name = "春颁而秋敛"
time_consume = 1
context = "立春前后，仓里陈粮见底、新粮还早，春耕却要起了。
掌粟官摊开册子：能动的粟就这么多，发下去是口粮，留着是种子，两样不能混。
开不开仓、按人头还是按亩、立不立券书，这几天就得定。"
event_level = 1
event_type = 2
trigger_terms = Array[int]([0])
is_meet = true
trigger_meet_info = Array[ExtResource("2_dt3yw")]([SubResource("Resource_cond0"), SubResource("Resource_cond1")])
