[resource]
script = ExtResource("1_l3b6a")
id = 75
sequence_id = "72"
display_name = "荔挺出"
time_consume = 1
context = "荔挺是马蔺，宿根的草——别的东西都枯着，它的芽却在最冷这几日开始往外顶。
老辈说这是阳气已经动了：冬至还没到，地下先知道了。
地里的冬麦也是这样，上头看着是黄的，根还在往下扎。地这时候还没冻透。"
event_level = 0
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([20])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
