[resource]
script = ExtResource("1_l3b6a")
id = 69
sequence_id = "66"
display_name = "雉入大水为蜃"
time_consume = 1
context = "野鸡一天比一天少见，水边却出了大蛤——蜃。
老辈说蜃会吐气，海上有城郭的影子，那是蜃气。今年水边也起了雾，有人说看见远处有墙有树。
蜃还有个用处：肉能吃，壳烧成灰刷在仓墙上，能隔潮——仓里的粮就是这么保住的。
是要追那道影子，还是下水捞蜃。"
event_level = 0
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([18])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
