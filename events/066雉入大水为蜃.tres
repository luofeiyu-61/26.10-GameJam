[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "一群人争蜃气是吉是凶，追那道影子追到天黑，什么也没追着；
回来时水边的蜃已被别人捞空了。"
