[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "当着里胥的面把种子倒出来数，陈的新的分开，缺的由官中补上；耦耕按有牛没牛配了对，耒耜也趁这几天修好。
这一年下种，没有一块地是空着的，出苗齐，补种的活全省了。"
