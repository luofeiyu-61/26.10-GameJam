[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "不改规矩，只让各家自己报个数，官上登记了就完事。
账面上种子是齐的；到底陈的多少、新的多少，只有各家自己知道，要等开春出了苗才见分晓。"
