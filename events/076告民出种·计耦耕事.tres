[resource]
script = ExtResource("1_l3b6a")
id = 79
sequence_id = "76"
display_name = "告民出种·计耦耕事"
time_consume = 2
context = "令有两句：一是各家报留种数，好知明年种什么、缺什么；                              二是农官排耦耕，谁和谁搭伙、谁家有牛谁家没牛，耒耜趁这时候一起修。种子是明年的根。                                                                                                     可报多了怕征，报少了自家不够；藏着不出的，要等下种才知道是陈种。                                                                                                      今年秋收一般，各家都把种子攥得紧。报实数，还是自己留着，得定。"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([22])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
