[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "谁也不肯先报，报上来的全是瘪的陈的，好种都藏在自家的瓮里。
开春一下种，出苗稀一片密一片，补都补不上，空出来的地只能荒着。"
