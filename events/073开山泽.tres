[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "划出几片山泽限时开放，派野虞跟着教规矩——只取成熟的、不取幼的，不砍活树；
其余照旧封着。这个冬有人靠山泽活了下来，明年山泽还在。"
