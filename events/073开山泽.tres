[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "不禁山泽，只「不诘」：田里剩下的、跑散的牲口，谁拿都不追问；
山泽照旧封着。零碎的拾走了，真正缺粮的还是缺。"
