[resource]
script = ExtResource("1_l3b6a")
id = 76
sequence_id = "73"
display_name = "开山泽"
time_consume = 2
context = "这个月有两条令：一条是山泽里的蔬食禽兽，能取的，让野虞教着去取；
一条是田里没收净的、牛马跑散了的，谁取走都不追问。
粮是进了仓，可不够撑到开春的人家还有不少。
搜山取田，是开是禁。"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([20])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
