[resource]
script = ExtResource("1_l3b6a")
id = 52
sequence_id = "50"
display_name = "鹰乃祭鸟"
time_consume = 1
context = "处暑的头一个候是鹰乃祭鸟——鹰把捕到的鸟一只只摆在地上，头朝同一个方向，像在摆祭品。
老猎人说，鹰肯这么摆，就是鸟兽都肥了的时候：猎得的禽兽能补上这一秋的肉食，弓矢兵器也正好趁这时候操练一遍。
可地里的谷还没收完。开不开猎、放多少人出去、走哪些地，这几天就得说定。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([13])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
