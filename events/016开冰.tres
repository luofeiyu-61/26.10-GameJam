[resource]
script = ExtResource("1_l3b6a")
id = 17
sequence_id = "16"
display_name = "开冰"
time_consume = 3
context = "腊月斩冰，三其凌（存三倍，因为要化掉大半），春天治鉴开窖，夏天颁冰，秋天刷窖。
一年一圈，年年如此。今天开窖。窖门一开，才知道化了多少。"
