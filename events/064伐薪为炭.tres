[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "为赶在上冻前多出炭，能动的都派上了山，窑挖得大、火也压不住。

落叶铺了一地，一阵风把火带出去，烧了半面山场。

炭没得着，明年连砍柴的地方都没了。"
meet_gua = Array[int]([3, 4])
