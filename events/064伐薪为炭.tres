[resource]
script = ExtResource("1_l3b6a")
id = 67
sequence_id = "64"
display_name = "伐薪为炭"
time_consume = 2
context = "霜降这时的叶子落尽了，树也睡了——这时候木头里水分最少，闷进窑里烧出来的炭最经烧、烟也最小；
等开春树一返青，含水一多，烧出来就全是烟。
可窑在山上，闷炭得有人住进去看着火；
眼下谷刚入仓、屋刚堵好，人一进山，家里就空了。"
event_level = 1
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([17])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
