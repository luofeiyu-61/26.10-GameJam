[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "不进山。就在村口把黄落的枝和下段硬木砍回来堆着，不起窑、不烧炭。

人一个没走，冬天屋里烟大、柴要现砍、烧得也快，可仓一直有人守。"
