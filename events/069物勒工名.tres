display_name = "物勒工名"
time_consume = 1
context = "冬月田里没活，正是验器的时候。                                                                          令上要工师把这一年做的器具摆出来，按尺寸法度一件件过；成了的，刻上工匠名字，往后坏了就找他。                                                                                今年要验耒、耜、镰、锄、车，还有宗庙祭器。                                                  有一批是新匠人做的，做得快，可尺寸总差一点。"
