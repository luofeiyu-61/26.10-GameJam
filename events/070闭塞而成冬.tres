[resource]
script = ExtResource("1_l3b6a")
id = 73
sequence_id = "70"
display_name = "闭塞而成冬"
time_consume = 2
context = "闭塞而成冬：坏城郭、戒门闾、修键闭、固封疆、备边竟、完要塞、谨关梁、塞徯径——该补的补，该堵的堵。
城墙有一段去年被雨水冲塌了，一直没修；
今年秋收一般，人也累了一整年。
是与不是全修，就看这几天。"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([19])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
