[resource]
script = ExtResource("1_l3b6a")
id = 63
sequence_id = "60"
display_name = "豺乃祭兽"
time_consume = 1
context = "草木黄落以后，野物藏不住了，豺也到了要贴着村子过冬的时候。
连着几夜，圈里少了羊；天亮到圈边一看，咬死的野兔、田鼠摆成一排，
摆得齐齐整整——老辈管这个叫「豺乃祭兽」，说豺在祭天。
管牲畜的人来问：要不要纠人进山围猎？
火把一闹，圈里的羊先要惊；不动手，一夜一夜地丢，一冬下来数目就难看了。"
event_level = 0
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([16])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
