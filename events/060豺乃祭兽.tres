[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "纠了几十个壮丁进山，围了一整天，连豺的影子都没见着。
等人回来，圈角空了一片，羊被拖走几只，血还在地上。"
