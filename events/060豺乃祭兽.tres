[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "赶了一夜豺，火把喊声闹到天亮，
豺是走了；可圈里的母羊受了惊，掉了几只羔。
大畜保住了，小畜折了。"
belief_feedback = -3
air_feedback = 1
earth_feedback = 2
people_feedback = 0
