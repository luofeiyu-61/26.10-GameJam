[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "不动豺。把圈口加高一道栅，夜里添人轮流值守，羊关进里间。
豺够不着，掉头去抓田里那些鼠和兔。
羊都守着了，一只不少"
