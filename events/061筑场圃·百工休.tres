[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "分清楚了——场圃是农事，趁土还松连夜赶完；
城上那段按令收工，用草苫盖住，墙基边上开沟把水引走。
冬雪落下化不了多少，开春接着夯。"
