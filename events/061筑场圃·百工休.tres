[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "都要。
白天赶场圃，夜里点火把赶土工；
土冻了就边烤边夯，看着跟去年一样板实。
开春雪一化，那一段先酥，再化就塌。"
belief_feedback = -3
air_feedback = -2
earth_feedback = 2
people_feedback = 0
animal_feedback = 0
grain_feedback = -20
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "农事一停，人也都放了。
场上没筑，十月的禾稼只能在田里碾，谷粒落了一地；
城上那半截没苫没沟，雪水灌进墙基冻胀，鼓起一排包，开春得连底挖掉重夯。"
meet_gua = Array[int]([2, 3])
