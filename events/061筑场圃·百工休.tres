[resource]
script = ExtResource("1_l3b6a")
id = 64
sequence_id = "61"
display_name = "筑场圃·百工休"
time_consume = 2
context = "此时正是百工休时，可活还没干完。
场圃，一地两用：春夏种菜，秋收时铲平夯实当打谷场。
头一场霜今晚就要落。场圃还没筑完，十月收的禾稼就无处登场脱粒；
城上那段土工也还剩半截。土一冻就夯不动了，这一停就停到明年开春。
人只有那么多，先赶哪一段，是个问题。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([16])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
