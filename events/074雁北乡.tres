[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "说雁都往北了，今年暖得早，冬麦的地先敞了，人也派去修沟。
谁知雁群在河滩上盘了两天又落回来，寒潮跟着就到——敞开的麦地冻死了一片，修沟的人也病倒几个。"
belief_feedback = -3
air_feedback = -3
earth_feedback = -1
people_feedback = -20
animal_feedback = -10
grain_feedback = -60
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "只把坏了的农具补一补，耦耕的配对等开春再说。
家伙事是齐的，可等到要下地，有牛的和没牛的还没搭好对，头几天耽误在地头。"
meet_gua = Array[int]([5, 3])
