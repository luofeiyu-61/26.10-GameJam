[resource]
script = ExtResource("1_l3b6a")
id = 77
sequence_id = "74"
display_name = "雁北乡"
time_consume = 1
context = "小寒，雁开始掉头往北了。
可这时候正是一年里最冷的一段，河还冻着，地还硬着，雁倒先动了。
老辈说这是阳气回头了，也有人说雁只是记着日子，跟冷不冷不相干。
令上这时候有一句：预备春耕，修农具，理田头，现在是时候了。
是照着雁动手，还是等天真的暖过来。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([22])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
