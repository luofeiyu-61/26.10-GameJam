[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "不追雁，也不等天暖。耒耜抬出来修，耦耕的人先配好对；人不下田，水不动土。
等到河开那几天，家伙事是现成的，头一趟下地没误一天。"
