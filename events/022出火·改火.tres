[resource]
script = ExtResource("1_l3b6a")
id = 23
sequence_id = "22"
display_name = "出火·改火"
time_consume = 2
context = "自清明这天起，野外用火合法了。
司爟还要\"四时变国火，以救时疾\"：四季换不同的木头钻燧取火（
春天用榆柳），换火是为了防这一季的病。
麻烦在于：旧火要全灭，新火要挨家分下去——中间那几天，家家吃冷饭。"
event_level = 1
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([4])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
