[resource]
script = ExtResource("1_l3b6a")
id = 14
sequence_id = "13"
display_name = "下剂致甿"
time_consume = 2
context = "雨水前后该起春耕了，可点一遍人丁，能下地的没几个。
人不够，地就种不过来。
这时候可以出榜：外边的人愿意来的，给田、给屋，头几年徭役减半。
只是，招，得拿田，也得拿粮；
空口出榜，人来了没处安置，反倒成患。
不招，这几块地今年就空着。"
event_level = 0
event_type = 1
trigger_type = 1
is_meet = true
trigger_meet_info = Array[ExtResource("2_dt3yw")]([SubResource("Resource_cond0")])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
