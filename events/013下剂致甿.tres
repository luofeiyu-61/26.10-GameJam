[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "田里实给了，屋也分了，头年徭役照榜上写的减半。
外来户当年就下了地，几块荒地有了主。"
meet_gua = Array[int]([6, 0])
belief_feedback = 8
air_feedback = 3
earth_feedback = 4
people_feedback = 60
animal_feedback = 20
grain_feedback = 100
