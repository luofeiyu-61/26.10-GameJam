[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "榜是出了，可写得不明白——田给多少、役减几年都没说死。
来的人站在榜前看了一晌，只来了三五家。"
belief_feedback = -2
air_feedback = 1
earth_feedback = 1
people_feedback = 30
animal_feedback = 0
grain_feedback = 60
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "榜上说减役，人来了却按人头摊派，说是先垫上。
有人第二夜就走了，走的时候把分到的农具也带走了。"
meet_gua = Array[int]([5, 4])
belief_feedback = -6
air_feedback = -2
earth_feedback = -4
people_feedback = 0
animal_feedback = -30
grain_feedback = -60
