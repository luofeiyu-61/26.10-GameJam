[resource]
script = ExtResource("1_l3b6a")
id = 74
sequence_id = "71"
display_name = "鹖鴠不鸣"
time_consume = 1
context = "鹖鴠是求旦的鸟，往常天不亮就叫，一直叫到天亮；这大雪的这几夜一声也没有了。
夜最长的日子到了，守夜的人少了这一个报时的参照，换班全凭估摸。
仓上、城上都还留着人守。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([20])
