[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_context = "先把仓里的粮腾出一半到别处，再堵洞、再熏，
熏完顺手把人住屋的北窗也一并堵了。
鼠没处躲，粮也没熏坏。"
meet_gua = Array[int]([3, 0])
belief_feedback = 3
air_feedback = 1
earth_feedback = 3
people_feedback = 20
animal_feedback = 10
grain_feedback = 40
