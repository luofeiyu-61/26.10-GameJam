[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "怕烟熏坏了刚入仓的粮，一样也没动，只在仓门口钉了块板、喊了几句。
一冬下来，仓角被掏出一个洞，粮袋咬破一片，地上撒了一层。"
meet_gua = Array[int]([1, 2])
belief_feedback = -5
air_feedback = -2
earth_feedback = -2
grain_feedback = -80
