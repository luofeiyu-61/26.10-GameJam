[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "只顾人：把人住的屋子堵严实、熏了一遍，暖和了；
仓那边只把门板钉了钉，窟窿没堵。
这个冬人不受冻，仓里少了一截。"
belief_feedback = -2
air_feedback = 1
earth_feedback = 1
people_feedback = 10
grain_feedback = -40
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[resource]
script = ExtResource("1_l3b6a")
id = 66
sequence_id = "63"
display_name = "穹窒熏鼠"
time_consume = 1
context = "虫都伏进土里，把洞封死了。
虫是退干净了，进屋的却换了一批：田里没了食，老鼠全往场上、仓里、屋角钻。
把窟窿堵死、用烟熏、把朝北的窗也堵上，便能治理鼠患。
麻烦在于仓刚装满、人住的屋子也刚堵好，烟一起，人得先出去。"
event_type = 2
trigger_terms = Array[int]([17])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
