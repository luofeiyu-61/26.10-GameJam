[resource]
script = ExtResource("1_l3b6a")
id = 48
sequence_id = "47"
display_name = "完堤防"
time_consume = 2
context = "立秋的令下来了：趁着水还没落干净，把堤防补完，把堵住的水道疏开——秋天的潦水还有一场要来。
同一道令里还说，宫室的墙垣、外面的城墙，这个月都得修。
可谷子正在地里等着人去割，人手只有这一批。
去年秋天那场水，就是从没人管的那截堤口漫进来的。"
event_level = 0
event_type = 2
trigger_type = 0
trigger_terms = Array[int]([12])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
