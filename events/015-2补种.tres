[resource]
script = ExtResource("1_l3b6a")
id = 17
sequence_id = "15.2"
display_name = "补种"
time_consume = 1
context = "那些被虫啃过的地，苗稀得看得见土。补撒一遍还赶得上，
可仓里那点种子原本是留着吃到夏收的——撒下去若再遭一场，
连口粮都没了。而且虫未必除净，它就伏在土里。"
