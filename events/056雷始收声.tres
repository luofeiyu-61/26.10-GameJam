[resource]
script = ExtResource("1_l3b6a")
id = 59
sequence_id = "56"
display_name = "雷始收声"
time_consume = 1
context = "雷到这天该停了。
雷不是神在响，是地里的热气顶上去撞出来的声音；
太阳一天比一天往南走，地气凉下来，就顶不动了。
要是过了秋分还打雷，说明热气没退干净，后面的雨断不了。
场上还摊着谷，仓里刚装的那批也没干透。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([15])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
