[resource]
script = ExtResource("1_l3b6a")
id = 57
sequence_id = "55.1"
display_name = "修桑"
time_consume = 1
context = "入了冬，坡上老桑叶落枝光。
蚕户说“枝乱根浅，得从头修”：不剪，明年芽多不壮，叶薄，蚕不肯上簇；剪了，新条粗，叶厚。他先剪自家那几棵，剪下的枝不烧，捆好埋沟里沤着。
乡邻说：砍了不如当柴，还能烧一冬。
砍不砍、留几棵，这几天得定。"
event_level = 0
event_type = 0
trigger_type = 1
is_after = true
trigger_after_event_id = Array[int]([56])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
