[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "只有几户跟着剪了，多数人家没动又或拿去当柴烧了。
蚕户坡上那几棵桑好，别家的照旧，一村两样。
丝换回的粟多了一点，不多。"
belief_feedback = -1
air_feedback = 3
earth_feedback = 1
