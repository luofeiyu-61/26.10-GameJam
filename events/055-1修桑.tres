[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "乡邻把不属于蚕户的老桑树砍了大半当柴烧。
剩下几棵歪在坡上，开春发的叶又薄又少，蚕上了簇也不结茧。
桑地荒了，坡上再没出过一匹好丝。"
meet_gua = Array[int]([5, 6])
belief_feedback = -6
air_feedback = -1
