[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "蚕户一家一家教着剪，剪下的枝统一沤在村外沟里。
第二年春分，坡上桑条比往年粗，蚕养得厚，丝换回的粟比往年多两成。
到了第三年，村里桑地连成一片，蚕户又教人栽新苗，
桑林比原先扩了一倍。"
meet_gua = Array[int]([2, 3])
