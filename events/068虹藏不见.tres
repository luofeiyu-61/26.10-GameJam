[resource]
script = ExtResource("1_l3b6a")
id = 71
sequence_id = "68"
display_name = "虹藏不见"
time_consume = 1
context = "天暖的时候，雨刚过、太阳斜着照过来，半空里挂一道虹——那是阳光穿过还没落下去的雨滴折出来的。
入冬以后这类雨少了，太阳也一天比一天低，虹就见不着了。
老辈讲，虹是天地还在往来的样子；虹藏了，就是上下不通，门该关了。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([19])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
