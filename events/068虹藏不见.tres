[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "只把它当天象记下来、占了一卦，「天地不通」讲得头头是道；
门照旧开着，市照旧散着。"
belief_feedback = -3
air_feedback = -2
earth_feedback = 2
people_feedback = 0
animal_feedback = 1
grain_feedback = 3
metadata/_custom_type_script = "uid://ous3wdnpxpwy"

[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "说哪有什么不通，一样也没闭。
头一场雪把赶集的人堵在半路，人冻坏了几个，车上的货也丢了。"
