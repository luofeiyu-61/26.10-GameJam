[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "贪那三倍的数，白冰也起、车也装满往回赶。
日头一暖，冰面吃不住重车，连人带车陷了一回；运回去的白冰入夏前就化得差不多了，真要用时反倒不够。"
belief_feedback = -3
air_feedback = -3
