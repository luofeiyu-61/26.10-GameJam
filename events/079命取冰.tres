[resource]
script = ExtResource("1_l3b6a")
id = 82
sequence_id = "79"
display_name = "命取冰"
time_consume = 2
context = "冰要冻透了。
这个时候下令：取回来的冰存进凌阴（冰窖），明年春夏颁给丧祭和公室用；
取的数要三倍于用得的数。
面上那层白的是冻得太快、里头全是气孔的，存到夏天就化；底下那种透的冻得慢，才存得住。
是凑三倍的数，还是要三倍的好冰。"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([23])
