[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "不凑三倍，只取凿得透的清冰，够用就停。
这个冬冰窖存得不多，可存下来的都是硬的；明年夏天够不够用，还要看这一冬冷不冷。"
