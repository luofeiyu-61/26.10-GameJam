[resource]
script = ExtResource("1_l3b6a")
id = 51
sequence_id = "49"
display_name = "农乃登谷·始收敛"
time_consume = 3
context = "七月，谷登场了——这是全年最要紧的一笔收成，比夏天的麦和黍都主。
割下来不能立刻入仓，得先在场上晒到咬得响，不然堆在廪里会发热霉变。
可秋天的潦水还有一场：晒得越透，淋雨的风险越大；抢着收进去，又要烂在廪里。
先割哪块田、晾几个日头、什么时候往廪里装，都在这几天。"
event_level = 1
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([12])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
