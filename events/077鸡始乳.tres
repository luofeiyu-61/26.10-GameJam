[resource]
script = ExtResource("1_l3b6a")
id = 80
sequence_id = "77"
display_name = "鸡始乳"
time_consume = 1
context = "母鸡开始抱窝了，趴在窝里不大起来，一天只下来吃一次。
这时候孵小鸡有两道难：一是冷，窝里一凉蛋就僵了，出了壳的雏也熬不过夜；
二是费粮，抱窝的鸡不吃也得撒一把，雏出来更要碎粮喂着。
仓里的粮正紧。是让它孵，还是把蛋收了吃、把鸡卖了换粮。"
event_level = 0
event_type = 0
trigger_type = 0
trigger_terms = Array[int]([23])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
