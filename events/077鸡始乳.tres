[sub_resource type="Resource" id="Resource_bad"]
script = ExtResource("1_dt3yw")
result_type = 2
result_context = "挑两三只老抱的留着孵，其余的蛋照旧收了吃、鸡也照旧卖。
这个冬添了十来只鸡，粮也没多费；明年要用的鸡雏够不够，还得看这几窝成不成。"
