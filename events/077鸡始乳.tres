[sub_resource type="Resource" id="Resource_good"]
script = ExtResource("1_dt3yw")
result_type = 0
result_context = "让它孵。窝垫厚、挪到灶边，抱窝的一天撒一把碎粮，出壳的雏再添一点。
这一冬添了几十只鸡：来年有蛋、有鸡，鸡粪也攒下了一堆。"
