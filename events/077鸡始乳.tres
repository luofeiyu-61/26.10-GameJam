[sub_resource type="Resource" id="Resource_normal"]
script = ExtResource("1_dt3yw")
result_type = 1
result_context = "说不孵了，蛋收来吃，鸡也卖了换粮。
省下的是这一冬的几斗碎粮；可窝是凉的，没收净的蛋冻裂在草里，来年开春一只雏也没有。"
belief_feedback = -3
air_feedback = -2
earth_feedback = 2
