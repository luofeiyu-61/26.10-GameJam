[resource]
script = ExtResource("1_l3b6a")
id = 56
sequence_id = "54"
display_name = "雁户来"
time_consume = 2
context = "白露头一候，鸿雁北来。                                                                     与往年不同，今年却有一家三口，赶着两辆车，从北边进了部族。                                                                                                        车上捆着桑苗、蚕种和粗布。男人说，北边秋汛早，桑林淹了，蚕屋塌了，想讨块地栽桑养蚕。                                                                           守门的犯难：收下，多三张嘴过冬；赶走，往后逃难的人不敢再来。管桑的老吏却眼睛一亮：部族桑少丝薄，正缺这手养蚕的本事。"
event_level = 0
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([14])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
