[resource]
script = ExtResource("1_l3b6a")
id = 55
sequence_id = "53"
display_name = "冬麦下种"
time_consume = 2
context = "白露是冬麦下种的口子。种早了，地还热，麦苗冬前拔节，一冻就死；种晚了，根没扎住，冬天也过不去。
老农看的是雁：鸿雁来齐了，就是下种的正时候。
可今年秋雨勤，地湿，有些田还进不去人。
等不等、先种哪块、湿田怎么处置，这几天定"
event_level = 1
event_type = 1
trigger_type = 0
trigger_terms = Array[int]([14])
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
