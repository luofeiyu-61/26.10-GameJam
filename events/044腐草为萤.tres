[resource]
script = ExtResource("1_l3b6a")
id = 45
sequence_id = "44"
display_name = "腐草为萤"
time_consume = 1
context = "大暑的头一个候，是腐草化出萤火来。
入伏以后，泽边积年的草烂成一层黑土，夜里就有萤从里头飞起来。
萤的幼虫吃螺，只肯待在又湿又肥的烂草层里——萤多不多，验的其实是这片泽的湿气和肥力。
今年泽边的草长得格外厚：放牛的想赶牛进去吃这块草，拾粪的想进去刨那层黑土当肥。
这片泽圈不圈，就在这几天。"
event_level = 0
event_type = 1
trigger_type = 2
result_good = SubResource("Resource_good")
result_normal = SubResource("Resource_normal")
result_bad = SubResource("Resource_bad")
metadata/_custom_type_script = "uid://g8wqe1w7ipgs"
